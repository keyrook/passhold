{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./.tsbuild",
    "rootDir": "../..",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@passhold/core": ["../../packages/core/src/index.ts"],
      "@keyrook/account": ["../../vendor/keyrook-account/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vite.config.ts"],
  "references": [{ "path": "../../packages/core" }]
}
